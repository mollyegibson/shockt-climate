# Copy to .env and fill in. Never commit .env.

# Postgres connection strings, one per login. On Neon, copy each from the console's Connect
# dialog (direct connection, not pooled), e.g.
#   postgresql://<user>:<password>@<endpoint>.us-east-2.aws.neon.tech/<database>?sslmode=require
# For local development (compose.yaml), all three can be the same superuser URL:
#   postgresql://shockt:shockt@localhost:5432/shockt

# Database owner; used only by Alembic migrations.
MIGRATIONS_DATABASE_URL=
# shockt_ingest login; used by the `shockt ingest` loaders.
DATABASE_URL=
# shockt_transform login; used by dbt.
DBT_DATABASE_URL=

# Neon Object Storage (S3-compatible) for archived source files. Use the main branch's endpoint
# and a credential created on main: the access key ID is the credential's token_id and the
# secret is its s3_secret_access_key, which Neon shows only once.
NEON_S3_ENDPOINT_URL=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_REGION=us-east-2
ARCHIVE_BUCKET=shockt-raw-archive

# Census Data API key (required on every data request): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Google Cloud project in BigQuery sandbox mode, used to query the Climate TRACE public dataset.
# Authenticate once with: gcloud auth application-default login
GCP_PROJECT_ID=

# Upper bound on bytes a single BigQuery query may scan (default 100 GB). The sandbox allows 1 TB a month.
BQ_MAX_BYTES=100000000000
